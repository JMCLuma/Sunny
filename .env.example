# Copy this file to .env.local and fill in the values for local development.
# .env.local is git-ignored. Never commit real values.

# App URL for the current environment
VITE_APP_URL=http://localhost:3000

# Supabase — PUBLIC values (safe in the browser; limited by RLS)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase — SERVER-ONLY secret. NEVER prefix with VITE_. Never ship to the client.
# Leave empty in .env.local unless you run server code that needs it.
SUPABASE_SERVICE_ROLE_KEY=
